<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <MechanicalVisualFramework.MechanicalModelDef>
    <defName>RMVF_StarterModel</defName>
    <assetPath>Models/Starter/model.xml</assetPath>
  </MechanicalVisualFramework.MechanicalModelDef>
  <ThingDef ParentName="BuildingBase">
    <defName>RMVF_Starter</defName>
    <label>Mechanical arm example</label>
    <description>A simple base and rotating arm. Open Animation controls to adjust its rotation.</description>
    <thingClass>MechanicalVisualFramework.Building_MechanicalDisplay</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <designationCategory>Misc</designationCategory>
    <fillPercent>0.5</fillPercent>
    <graphicData>
      <texPath>RMVF/Fallback</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
    <size>(2, 2)</size>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>10</Steel>
    </costList>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="MechanicalVisualFramework.CompProperties_MechanicalVisual">
        <model>RMVF_StarterModel</model>
        <autoplay>spin</autoplay>
      </li>
    </comps>
  </ThingDef>
  <MechanicalVisualFramework.MechanicalModelDef>
    <defName>RMVF_DeploymentModel</defName>
    <assetPath>Models/Deployment/model.xml</assetPath>
  </MechanicalVisualFramework.MechanicalModelDef>
