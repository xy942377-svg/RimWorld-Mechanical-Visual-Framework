      </li>
    </comps>
  </ThingDef>
  <MechanicalVisualFramework.MechanicalModelDef>
    <defName>RMVF_TripleTurretModel</defName>
    <assetPath>Models/TripleTurret/model.xml</assetPath>
  </MechanicalVisualFramework.MechanicalModelDef>
  <ThingDef ParentName="BuildingBase">
    <defName>RMVF_TripleTurret</defName>
    <label>Triple turret visual example</label>
    <description>Demonstrates continuous rotation, independent gun elevation and recoil. Open Animation controls to adjust the pose and play clips. This example does not fire projectiles.</description>
